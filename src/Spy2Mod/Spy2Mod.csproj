<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Spy2Mod</AssemblyName>
    <RootNamespace>Spy2Mod</RootNamespace>
    <Sts2DataDir>$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(Sts2Dir)' == ''" Text="Sts2Dir is required. Use scripts/Build-Mod.ps1 after Configure-Local.ps1." />
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="Game assembly sts2.dll was not found in Sts2DataDir." />
    <Error Condition="!Exists('$(Sts2DataDir)/0Harmony.dll')" Text="Game assembly 0Harmony.dll was not found in Sts2DataDir." />
  </Target>
</Project>
